{
  "name": "localme",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start --hostname 0.0.0.0",
    "runflare:start": "node scripts/runflare-start.mjs",
    "runflare:deploy": "node scripts/runflare-start.mjs",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run --exclude 'tests/db/postgres.*'",
    "test:postgres": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run tests/db/postgres.data-layer.test.ts",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "backup": "node scripts/backup.mjs",
    "seed": "node ./node_modules/vite-node/vite-node.mjs --config vitest.config.ts scripts/seed-demo.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "acme-client": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "^8.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
