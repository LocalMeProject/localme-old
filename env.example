# LocalMe — environment template
# Copy to .env.local for development; set the same keys in your host's
# environment settings for production.

# Database driver: "sqlite" (default) or "postgres".
# SQLite is zero-config for local dev and CI; Postgres is the production path
# (see docs/adr/003).
DB_DRIVER="sqlite"

# SQLite only: a file-backed database. Leave unset for an in-memory database.
# Must be an ABSOLUTE path: `file:./data/x.db` is a SQLite URI, not a file path,
# and is rejected rather than resolved against the working directory — that
# ambiguity is how the server and `npm run db:migrate` end up on two databases.
# DB_PATH="file:/var/lib/localme/localme.db"

# Postgres only: connection string (Neon free tier works; any Postgres 14+).
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Storage directory for uploaded user assets.
# When unset, defaults to `storage_data` in the application working directory.
# In container environments (e.g., Runflare with a mounted persistent volume):
# STORAGE_DATA_DIR="/app/storage_data"
# DB_PATH="file:/app/storage_data/localme.db"
# (Both SQLite and uploaded files can live together in the same persistent volume).

# HMAC secret for session integrity, and the seed for the AES-256-GCM key that
# encrypts stored secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# OPTIONAL. When unset, the platform generates a high-entropy secret on first boot
# and persists it to both `system_configs` and `data/.session_secret`, surviving
# restarts with zero configuration required. Set it explicitly if you prefer managing
# secrets via your host's environment settings.
SESSION_SECRET=""

# Public origin of this deployment (e.g. https://localme.ir).
# OPTIONAL. The platform automatically uses relative URLs and detects the active Host
# from incoming HTTP headers (X-Forwarded-Host / Host). Set this only if you want to
# enforce fixed canonical URLs in SEO metadata, OpenGraph tags, or sitemaps.
NEXT_PUBLIC_SITE_URL=""

# Shared secret the platform cron runner presents to POST /api/cron/run
# (`x-cron-token`). When unset, only project-scoped manual runs are allowed and
# no unattended execution happens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PLATFORM_CRON_TOKEN=""

# `next dev` only. Comma-separated hosts (wildcards allowed) allowed to load
# /_next/*. Without it, serving the dev server from anything other than localhost
# gets 403 on every chunk and the page renders but never hydrates. next.config.ts
# already allowlists localhost, 127.0.0.1 and the workspace preview domain.
# ALLOWED_DEV_ORIGINS="*.example.com,tunnel.localhost"

# ---------------------------------------------------------------------------
# First-boot administrator.
#
# A deployment with zero users cannot reach /admin at all, so the platform
# creates one administrator the first time it starts against an empty database
# (triggered by GET /health). It then never bootstraps again — the moment anyone
# signs up, this is inert. Manage the account from the admin console afterwards.
#
#   ADMIN_INITIAL_USERNAME .......... admin    the account it creates
#   ADMIN_INITIAL_PASSWORD .......... admin1234  the default; set your own
#   ALLOW_DEFAULT_ADMIN_PASSWORD .... unset     set to "1" to accept admin1234
#                                               in production
#
# In production the default password is REFUSED unless you set
# ALLOW_DEFAULT_ADMIN_PASSWORD=1, so a deployment can never end up sitting on a
# published credential because nobody read this file.
# ADMIN_INITIAL_USERNAME=""
# ADMIN_INITIAL_PASSWORD=""
# ALLOW_DEFAULT_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Everything below is a *system config* row, not an environment variable: it is
# edited at /admin/settings (or PUT /api/admin/config) and takes effect without a
# redeploy. Listed here so the defaults are discoverable.
#
#   storage.default_user_cap_bytes ... 2097152  2 MB of project files per account
#   storage.library_cap_bytes ........ 3145728  3 MB of shared library assets
#   storage.max_user_cap_bytes ....... 1073741824 ceiling for an admin to grant
#   storage.minify_on_save ............ true   minify CSS/JS/JSON/HTML/SVG on upload
#   serving.hotlink_protection ........ true   Referer/Origin check on assets
#   logging.level ...................... info   debug | info | warn | error
#   logging.sink ....................... stdout stdout | file (newline-delimited JSON)
#   logging.file_path .................. —      destination when sink=file
#   webhooks.retry_failed .............. false  spec §5.9: "Retry: No retries"
#   webhooks.max_attempts .............. 5
#   webhooks.retry_backoff_seconds ..... 60
#   webhooks.allow_private_targets ..... false   allow webhooks to reach private/LAN addresses
#   ssl.auto_provision ................ false  let the platform order certificates
#   ssl.acme_staging .................. true   use the staging CA by default
#   ssl.acme_directory_url ............ —      defaults to the staging directory
#   ssl.acme_contact_email ............ —      contact address for expiry notices
#   ssl.renewal_days_before_expiry ..... 30
#   zarinpal.merchant_id ............... —      ZarinPal Merchant ID (configured in /admin/settings)
#   subscription.tiers ................. JSON   Dynamic tier definitions & pricing (Free, Plus, Pro)
# ---------------------------------------------------------------------------

# Note: there is no separate encryption key. The AES-256-GCM key for stored
# secrets is derived from SESSION_SECRET with scrypt, so rotating SESSION_SECRET
# invalidates every stored secret and every session — take a backup first. With
# SESSION_SECRET unset, the generated fallback is used for both, so rotating it
# means setting SESSION_SECRET to a different value before first boot.
